/sample vault/.obsidian/workspace*.json
/sample vault/.obsidian/app.json
/sample vault/.obsidian/appearance.json
/sample vault/.obsidian/core-plugins*.json
/sample vault/.obsidian/graph.json
/sample vault/.trash/
